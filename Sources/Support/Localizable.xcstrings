    "welcome.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an API key for either assistant to start. Keys are stored in this device's Keychain and are sent only to the assistant they belong to."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione a chave de API de uma das duas para começar. As chaves ficam no Keychain deste aparelho e só são enviadas para a IA a que pertencem."
          }
        }
      }
    },
    "welcome.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude and Gemini, side by side"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude e Gemini, lado a lado"
          }
        }
      }
