    "settings.pairing.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neither assistant lets another app sign in with your personal account, so the keys come from the Mac that already holds them — over your own network, and only while this code is on screen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma das duas IAs deixa outro app entrar com a sua conta, então as chaves vêm do Mac que já as guarda — pela sua própria rede, e só enquanto este código está na tela."
          }
        }
      }
    },
    "settings.reasoning": {
